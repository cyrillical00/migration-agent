# Migration Agent -- environment variables
# Copy to .env and fill in real values for local dev.
# Never commit .env.

# ---- Core ----
MIGRATION_AGENT_ENV=dev
MIGRATION_AGENT_SECRET_KEY=changeme-dev-only

# ---- Database ----
MIGRATION_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/migration_agent

# ---- Supabase ----
MIGRATION_AGENT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
MIGRATION_AGENT_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Slack ----
MIGRATION_AGENT_SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN
MIGRATION_AGENT_SLACK_SIGNING_SECRET=YOUR_SIGNING_SECRET
MIGRATION_AGENT_SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN

# ---- Anthropic ----
MIGRATION_AGENT_ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# ---- Google Cloud ----
MIGRATION_AGENT_GCP_PROJECT=migration-agent-dev
MIGRATION_AGENT_GCS_AUDIT_BUCKET=migration-agent-audit-dev

# ---- MS Graph (dev stub config) ----
MIGRATION_AGENT_GRAPH_STUB_URL=http://localhost:8001

# ---- Google API stub ----
MIGRATION_AGENT_GOOGLE_STUB_URL=http://localhost:8002

# ---- Fake GCS ----
MIGRATION_AGENT_FAKE_GCS_URL=http://localhost:4443

# ---- Rate limits (can override defaults) ----
# MIGRATION_AGENT_GRAPH_RATE_LIMIT_REQUESTS_PER_10MIN=10000
# MIGRATION_AGENT_DRIVE_RATE_LIMIT_PER_USER_QPS=10
# MIGRATION_AGENT_SLACK_RATE_LIMIT_ADMIN_PER_MIN=20

# ---- Dashboard ----
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
